{
  "name": "nihonco-jp",
  "version": "0.7.38",
  "description": "Live2D 日语语音对话学习桌宠：本地语音识别 + 云端 LLM + VOICEVOX 小夜声线",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js --no-sandbox",
    "pet": "electron main.js --no-sandbox",
    "setup": "node tools/setup.mjs",
    "build:app": "node tools/build-app.mjs --target=mac --mode=lite",
    "build:app:lite": "node tools/build-app.mjs --target=mac --mode=lite",
    "build:app:lite:mlx": "node tools/build-app.mjs --target=mac --mode=lite --with-mlx",
    "build:jlpt": "node tools/build-jlpt-data.mjs",
    "scan": "node tools/scan.mjs",
    "release": "node tools/release.mjs",
    "test": "node tools/run-tests.mjs",
    "test:watch": "node tools/run-tests.mjs --watch",
    "smoke": "node tools/smoke.mjs",
    "setup:whisper": "node tools/setup-whisper.mjs",
    "snapshot:readings": "node tools/snapshot-readings.mjs",
    "build:win": "npm run build:win:lite",
    "build:win:dir": "npm run build:win:lite:dir",
    "check:assets:lite": "node tools/check-assets.mjs --lite",
    "build:win:lite": "node tools/build-app.mjs --target=win --mode=lite",
    "build:win:lite:dir": "node tools/build-app.mjs --target=win --mode=lite --dir",
    "build:win:lite:nsis": "node tools/build-app.mjs --target=win --mode=lite --format=nsis",
    "build:win:lite:portable": "node tools/build-app.mjs --target=win --mode=lite --format=portable",
    "setup:mlx": "node tools/setup-mlx.mjs",
    "smoke:settings": "node tools/settings-smoke.mjs",
    "demo": "node tools/demo.mjs"
  },
  "keywords": [],
  "author": "KronosOceanus",
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@pixi/unsafe-eval": "^7.4.3",
    "@polyglot-bundles/ja-jlpt-syllabi": "^0.1.5",
    "adm-zip": "^0.6.1",
    "kuromoji": "^0.1.2",
    "pixi-live2d-display-lipsyncpatch": "^0.5.0-ls-8",
    "pixi.js": "^7.4.3"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "jp.nihonco.app",
    "productName": "Nihonco",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "agent/**/*.js",
      "main/**/*.js",
      "renderer/**/*.js",
      "preload.js",
      "preload-settings.js",
      "settings/**/*",
      "pet.html",
      "pet.js",
      "ui.css",
      "data/jlpt.json",
      "data/word-levels.json",
      "data/kanji-stems.json",
      "data/pattern-gloss-zh.json",
      "data/patterns-n5.json",
      "data/patterns-n4.json",
      "data/patterns-n3.json",
      "data/patterns-n2.json",
      "data/patterns-n1.json",
      "data/enrich-cache.seed.json",
      "!**/*.map",
      "!tests/**",
      "!tools/**",
      "!docs/**",
      "!dist/**",
      "!**/*.log",
      "node_modules/kuromoji/**",
      "node_modules/doublearray/**",
      "node_modules/zlibjs/**",
      "node_modules/async/**"
    ],
    "asar": true,
    "asarUnpack": [
      "data/*.json"
    ],
    "mac": {
      "icon": "assets/AppIcon.icns"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Nihonco",
      "artifactName": "Nihonco-${version}-lite-setup.exe"
    },
    "portable": {
      "artifactName": "Nihonco-${version}-lite-portable.exe"
    },
    "compression": "normal"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KronosOceanus/Nihonco_JP.git"
  },
  "homepage": "https://github.com/KronosOceanus/Nihonco_JP#readme",
  "bugs": {
    "url": "https://github.com/KronosOceanus/Nihonco_JP/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
