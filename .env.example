# 复制为 .env 后填写（.env 不要提交到 git）
# ─────────────────────────────────────────────
# 必填：语言模型（OpenAI 兼容接口）
# ─────────────────────────────────────────────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000

# ─────────────────────────────────────────────
# 常用
# ─────────────────────────────────────────────
# 学习者水平：N5 / N4 / N3 / N2 / N1（之后以界面上的 N5 按钮为准）
JP_LEVEL=N4

# 语音识别
ASR_LANG=ja                                    # ja（默认，最快）/ zh / auto（中日混判，稍慢）
ASR_BACKEND=whispercpp  # 默认 whisper.cpp；mac 也可改 mlx（需 .venv + mlx 模型）
ASR_MODEL=ggml-small-q5_1.bin  # whisper.cpp 模型文件名；mlx 时填 HF 仓库名
# HF_ENDPOINT=https://hf-mirror.com            # 国内下载模型慢时用镜像

# 语音合成（VOICEVOX / AivisSpeech；不再回落系统 say）
TTS_ENGINE=voicevox       # voicevox / aivis
VOICEVOX_URL=http://127.0.0.1:50021
AIVIS_URL=http://127.0.0.1:10101
VOICEVOX_NAME=小夜        # 按角色名匹配声线
AIVIS_NAME=まお
VOICEVOX_SPEED=1.0        # 语速倍率
VOICEVOX_PITCH=0.0        # 音高（-0.15 ~ 0.15）
VOICEVOX_INTONE=1.0       # 语调强弱
VOICEVOX_VOLUME=1.0       # 音量
VOICEVOX_PEAK=1.0         # 峰值归一化目标（1.0 = 不归一化）

# ─────────────────────────────────────────────
# 可选：本地 Ollama 兜底（没填 LLM_API_KEY 时会自动探测）
# ─────────────────────────────────────────────
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ─────────────────────────────────────────────
# 自检 / 调试（正常使用不用管）
# ─────────────────────────────────────────────
# MOCK_LLM=1               # 不联网，返回固定回答
# PET_LEVEL=floating       # 窗口层级：floating（默认，不挡输入法）/ screen-saver（压住一切）
# PET_DEBUG=1              # 打印静态服务端口等调试信息
#
# 截图 / 自动化验证（开发用）：
# PET_SHOT=1 PET_SHOT_DELAY=8000 PET_SHOT_EXIT=1
# PET_EVAL="..."  PET_EVAL_DELAY=6000        # 在渲染层执行一段 JS
# PET_MODE_TEST=word  PET_CHAT_TEST=1  PET_SAY="..."  PET_MIC_TEST=1
# PET_TTS_TEST=1  PET_ASR_TEST=1  PET_WORD_TEST=1  PET_KEY_TEST=1

# Live2D 模型（可选）。留空用内置的 Hiyori。
# LIVE2D_MODEL=model/miku/miku.model3.json

# 自检/冒烟测试用：Electron 用户数据目录（默认 .electron-data）。
# 指到临时目录后，可以和正在运行的应用同时起实例（不抢单实例锁）。
# NIHONCO_USER_DATA=/tmp/nihonco-smoke
